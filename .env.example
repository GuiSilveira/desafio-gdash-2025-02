# ============================================
# GDASH Weather Monitoring System
# Arquivo de exemplo de variaveis de ambiente
# ============================================
# Copie este arquivo para .env e ajuste os valores conforme necessario
# cp .env.example .env

# --------------------------------------------
# MongoDB
# --------------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root123
MONGO_PORT=27017
MONGO_DB_NAME=gdash_weather

# --------------------------------------------
# RabbitMQ
# --------------------------------------------
RABBITMQ_DEFAULT_USER=gdash
RABBITMQ_DEFAULT_PASS=gdash123
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --------------------------------------------
# Weather Collector (Python)
# --------------------------------------------
# Cidade e coordenadas para coleta de dados meteorologicos
TARGET_CITY=Caruaru
TARGET_LAT=-8.2833
TARGET_LON=-35.9761

# --------------------------------------------
# Core API (NestJS)
# --------------------------------------------
API_PORT=3000
API_URL=http://core-api:3000

# Segredo para assinatura de tokens JWT (ALTERE EM PRODUCAO!)
JWT_SECRET=sua-chave-jwt-super-secreta-aqui

# Token para comunicacao interna entre servicos (weather-worker -> core-api)
INTERNAL_API_TOKEN=seu-token-interno-seguro-aqui

# Usuario administrador padrao (criado automaticamente na inicializacao)
ADMIN_EMAIL=admin@gdash.com
ADMIN_PASS=123456

# Chave da API Google Gemini (necessaria para insights de IA)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui

# --------------------------------------------
# Web App (React + Vite)
# --------------------------------------------
WEB_PORT=5173

# Nota: VITE_API_URL e definido automaticamente no docker-compose.yml
# Para desenvolvimento local fora do Docker, crie um .env no services/web-app/
# com: VITE_API_URL=http://localhost:3000

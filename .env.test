# E2E Test Environment Variables
NODE_ENV=test
PORT=3001

# MongoDB Test Database
MONGODB_URI=mongodb://localhost:27017/gdash-test

# JWT
JWT_SECRET=test-jwt-secret-key-for-e2e-tests
JWT_EXPIRES_IN=1h

# Internal API Token
INTERNAL_API_TOKEN=test-internal-token-for-e2e

# Google Gemini (pode ser fake para testes)
GEMINI_API_KEY=test-gemini-key

# RabbitMQ (não usado em e2e, mas precisa estar definido)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
